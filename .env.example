# ─── App ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
TZ=Asia/Jakarta

# ─── Payload ───────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 24
PAYLOAD_SECRET=YOUR_SECRET_HERE

# ─── Database (PostgreSQL) ─────────────────────────────────────────────────
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
DB_HOST=localhost
DB_PORT=5432
DB_USER=payload
DB_PASSWORD=payload
DB_NAME=cms

# ─── Seed admin user ───────────────────────────────────────────────────────
PAYLOAD_ADMIN_EMAIL=admin@example.com
PAYLOAD_ADMIN_PASSWORD=CHANGE_ME

# --- payload-puck-advance ---
# URL CMS dari sisi frontend. Beda domain? Isi dengan URL absolutnya.
NEXT_PUBLIC_CMS_URL=http://localhost:3001
# URL frontend yang akan dipanggil hook publish untuk purge cache.
FRONTEND_URL=http://localhost:3030
# Dibaca di BROWSER oleh canvas Puck (stylesheetFrom), jadi wajib NEXT_PUBLIC_.
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3030
# Shared secret endpoint revalidate. Tanpa ini, revalidate DIMATIKAN (gagal
# tertutup) — endpoint purge cache tanpa secret bisa ditekan siapa pun.
REVALIDATE_SECRET=ganti-dengan-nilai-acak-panjang
